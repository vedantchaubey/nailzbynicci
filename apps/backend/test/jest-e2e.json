{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-happy-path.spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@ticketpass/shared$": "<rootDir>/../../../packages/shared/src",
    "^@ticketpass/shared/(.*)$": "<rootDir>/../../../packages/shared/src/$1",
    "^(\\./.*)\\.js$": "$1",
    "^(\\.\\./.*)\\.js$": "$1"
  }
}
