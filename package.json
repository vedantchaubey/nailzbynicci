{
  "name": "ticketpass-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TicketPass - Verified ownership transfer marketplace for sold-out events",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/backend && npm run build --workspace=apps/frontend",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=apps/backend && npm run typecheck --workspace=apps/frontend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@types/node": "^20.14.9",
    "prettier": "^3.3.2",
    "prisma": "5.22.0",
    "readable-stream": "^4.8.0",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@next/swc-win32-x64-msvc": "^14.2.33",
    "@prisma/engines": "5.22.0",
    "@prisma/fetch-engine": "7.10.1",
    "asynckit": "^0.5.0",
    "autoprefixer": "^10.6.1",
    "body-parser": "^2.4.0",
    "csstype": "^3.2.3",
    "external-editor": "^3.1.0",
    "form-data": "^4.0.6",
    "iconv-lite": "^0.7.3",
    "iterare": "^1.2.1",
    "math-intrinsics": "^1.1.0",
    "object-inspect": "^1.13.4",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "raw-body": "^4.0.0",
    "socket.io": "^4.8.4",
    "socket.io-adapter": "^2.5.8",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  }
}
